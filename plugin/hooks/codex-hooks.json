{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "NOMOR=\"${PLUGIN_ROOT}\"; NOMOS=\"$HOME/.config/cc-status/hook-shim.sh\"; [ -n \"$NOMOR\" ] && [ -x \"$NOMOR/scripts/run.sh\" ] && exec \"$NOMOR/scripts/run.sh\" \"$NOMOR/dist/codex-status.mjs\"; [ -x \"$NOMOS\" ] && exec \"$NOMOS\" codex-status; exit 0", "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "NOMOR=\"${PLUGIN_ROOT}\"; NOMOS=\"$HOME/.config/cc-status/hook-shim.sh\"; [ -n \"$NOMOR\" ] && [ -x \"$NOMOR/scripts/run.sh\" ] && exec \"$NOMOR/scripts/run.sh\" \"$NOMOR/dist/codex-status.mjs\"; [ -x \"$NOMOS\" ] && exec \"$NOMOS\" codex-status; exit 0", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "NOMOR=\"${PLUGIN_ROOT}\"; NOMOS=\"$HOME/.config/cc-status/hook-shim.sh\"; [ -n \"$NOMOR\" ] && [ -x \"$NOMOR/scripts/run.sh\" ] && exec \"$NOMOR/scripts/run.sh\" \"$NOMOR/dist/codex-status.mjs\"; [ -x \"$NOMOS\" ] && exec \"$NOMOS\" codex-status; exit 0", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "NOMOR=\"${PLUGIN_ROOT}\"; NOMOS=\"$HOME/.config/cc-status/hook-shim.sh\"; [ -n \"$NOMOR\" ] && [ -x \"$NOMOR/scripts/run.sh\" ] && exec \"$NOMOR/scripts/run.sh\" \"$NOMOR/dist/codex-status.mjs\"; [ -x \"$NOMOS\" ] && exec \"$NOMOS\" codex-status; exit 0", "timeout": 30 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "NOMOR=\"${PLUGIN_ROOT}\"; NOMOS=\"$HOME/.config/cc-status/hook-shim.sh\"; [ -n \"$NOMOR\" ] && [ -x \"$NOMOR/scripts/run.sh\" ] && exec \"$NOMOR/scripts/run.sh\" \"$NOMOR/dist/codex-permission.mjs\"; [ -x \"$NOMOS\" ] && exec \"$NOMOS\" codex-permission; exit 0", "timeout": 3600 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "NOMOR=\"${PLUGIN_ROOT}\"; NOMOS=\"$HOME/.config/cc-status/hook-shim.sh\"; [ -n \"$NOMOR\" ] && [ -x \"$NOMOR/scripts/run.sh\" ] && exec \"$NOMOR/scripts/run.sh\" \"$NOMOR/dist/codex-status.mjs\"; [ -x \"$NOMOS\" ] && exec \"$NOMOS\" codex-status; exit 0", "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "NOMOR=\"${PLUGIN_ROOT}\"; NOMOS=\"$HOME/.config/cc-status/hook-shim.sh\"; [ -n \"$NOMOR\" ] && [ -x \"$NOMOR/scripts/run.sh\" ] && exec \"$NOMOR/scripts/run.sh\" \"$NOMOR/dist/codex-status.mjs\"; [ -x \"$NOMOS\" ] && exec \"$NOMOS\" codex-status; exit 0", "timeout": 3 }
        ]
      }
    ]
  }
}
