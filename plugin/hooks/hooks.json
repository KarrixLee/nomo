{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "NOMOR=\"${CLAUDE_PLUGIN_ROOT}\"; NOMOS=\"$HOME/.config/cc-status/hook-shim.sh\"; [ -n \"$NOMOR\" ] && [ -x \"$NOMOR/scripts/run.sh\" ] && exec \"$NOMOR/scripts/run.sh\" \"$NOMOR/dist/cc-status.mjs\"; [ -x \"$NOMOS\" ] && exec \"$NOMOS\" cc-status; exit 0" }] }
